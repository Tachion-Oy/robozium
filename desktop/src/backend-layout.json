{
  "x-desktop": {
    "composeEnvironment": ".runtime/compose.env",
    "dockerLog": {
      "mount": "/logs",
      "filename": "docker.log"
    },
    "locations": {
      "checkoutProfile": "../../.artifacts/desktop/data",
      "checkoutPreviewProfile": "../../.artifacts/desktop/scaffold",
      "installedPreviewProfile": "preview",
      "installedBackend": "backend",
      "checkoutBackend": "..",
      "installedSource": "stage",
      "checkoutSource": ".stage/backend",
      "compose": "compose.yaml",
      "settings": "settings.json",
      "installationId": "backend-installation-id",
      "hubFolder": "hub-folder",
      "defaultHub": "~/Robozium-Hub",
      "isolatedHub": "hub",
      "hubProjects": "projects"
    }
  },
  "services": {
    "api": {
      "env_file": [
        {
          "path": "${ROBOZIUM_DESKTOP_RUNTIME:?Select an absolute desktop runtime directory}/.env.encrypt",
          "required": false
        },
        {
          "path": "${ROBOZIUM_DESKTOP_RUNTIME:?Select an absolute desktop runtime directory}/.env",
          "required": false
        }
      ],
      "environment": {
        "ROBOZIUM_HUB_ROOT": "/hub",
        "ROBOZIUM_LOG_DIR": "/logs",
        "ROBOZIUM_ENCRYPTED_ENV_PATH": "/configuration/.env.encrypt",
        "ROBOZIUM_HOST_SCRIPT_SOCKET": "/host-scripts/scripts.sock"
      },
      "volumes": [
        {
          "type": "bind",
          "source": "${ROBOZIUM_DESKTOP_RUNTIME:?Select an absolute desktop runtime directory}",
          "target": "/configuration",
          "read_only": false,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${ROBOZIUM_DESKTOP_RUNTIME:?Select an absolute desktop runtime directory}/local",
          "target": "/app/local",
          "read_only": false,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${ROBOZIUM_DESKTOP_RUNTIME:?Select an absolute desktop runtime directory}/.runtime/local-deps",
          "target": "/app/.runtime/local-deps",
          "read_only": false,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${ROBOZIUM_DESKTOP_HUB:?Select an absolute hub folder}",
          "target": "/hub",
          "read_only": false,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${ROBOZIUM_DESKTOP_RUNTIME:?Select an absolute desktop runtime directory}/.runtime/logs",
          "target": "/logs",
          "read_only": false,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${ROBOZIUM_DESKTOP_RUNTIME:?Select an absolute desktop runtime directory}/.runtime/host-socket",
          "target": "/host-scripts",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${ROBOZIUM_DESKTOP_HUB:?Select an absolute hub folder}/readonly/safe-scripts",
          "target": "/hub/readonly/safe-scripts",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ]
    }
  }
}
