{
  "desktop": {
    "containerLog": {
      "mount": "/logs",
      "filename": "container.log"
    },
    "containerEnvironment": ".runtime/container.env",
    "hostServices": {
      "environment": ".runtime/host-environment",
      "processes": ".runtime/host-services",
      "environmentLog": {
        "mount": "/logs",
        "filename": "host-environment.log"
      },
      "services": {
        "safe-scripts": {
          "platforms": ["linux"],
          "modes": ["live"],
          "endpoint": {
            "type": "unix-socket",
            "variable": "ROBOZIUM_HOST_SCRIPT_SOCKET"
          },
          "log": {
            "mount": "/logs",
            "filename": "safe-scripts.log"
          },
          "executable": "bin/roboz",
          "arguments": [
            "scripts", "serve",
            "--socket", { "endpoint": "address" },
            "--scripts", { "hostPath": "/hub/readonly/safe-scripts" },
            "--cwd", { "hostPath": "/hub" },
            "--timeout-s", "600",
            "--allow-env", "HOME", "--allow-env", "USER", "--allow-env", "LOGNAME",
            "--allow-env", "XDG_CONFIG_HOME", "--allow-env", "XDG_DATA_HOME", "--allow-env", "XDG_CACHE_HOME"
          ]
        }
      }
    },
    "locations": {
      "checkoutProfile": "../../.artifacts/desktop/data",
      "installedBackend": "backend",
      "checkoutBackend": "..",
      "installedSource": "stage",
      "checkoutSource": ".stage/backend",
      "preload": "preload.cjs",
      "renderer": "renderer",
      "settings": "settings.json",
      "installationId": "backend-installation-id",
      "hubFolder": "hub-folder",
      "defaultHub": "~/Robozium-Hub",
      "isolatedHub": "hub",
      "hubProjects": "projects"
    }
  },
  "backend": {
    "buildTarget": "api",
    "environment": {
      "ROBOZIUM_CONFIG": "/app/hub.config.py",
      "ROBOZIUM_HUB_ROOT": "/hub",
      "ROBOZIUM_LOG_DIR": "/logs",
      "ROBOZIUM_ENCRYPTED_ENV_PATH": "/configuration/.env.encrypt",
      "ROBOZIUM_HOST_SCRIPT_SOCKET": "/host-scripts/scripts.sock"
    },
    "mounts": [
      { "root": "runtime", "path": "", "target": "/configuration", "readOnly": false },
      { "root": "runtime", "path": "local", "target": "/app/local", "readOnly": false },
      { "root": "runtime", "path": ".runtime/local-deps", "target": "/app/.runtime/local-deps", "readOnly": false },
      { "root": "hub", "path": "", "target": "/hub", "readOnly": false },
      { "root": "runtime", "path": ".runtime/logs", "target": "/logs", "readOnly": false },
      { "root": "runtime", "path": ".runtime/host-socket", "target": "/host-scripts", "readOnly": true },
      { "root": "hub", "path": "readonly/safe-scripts", "target": "/hub/readonly/safe-scripts", "readOnly": true }
    ],
    "command": ["uvicorn", "robozium.api.app:{mode}_app", "--factory", "--host", "{address}", "--port", "{port}", "--workers", "1"],
    "stopTimeoutSeconds": 30
  }
}
