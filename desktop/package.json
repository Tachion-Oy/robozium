{
  "name": "robozium-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Robozium desktop application",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "build": "npm run typecheck && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && tsc -p tsconfig.preload.json && vite build && node scripts/build-icon.ts",
    "start": "npm run backend:stage && npm run build && electron .",
    "package:linux": "npm run backend:stage && npm run build && electron-builder --linux deb",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p renderer/tsconfig.json && tsc -p tsconfig.tests.json && tsc -p tsconfig.node.json",
    "backend:stage": "node scripts/stage-backend.ts",
    "test:backend": "node --test backend-tests/*.test.ts",
    "test:backend:lifecycle": "node --test backend-tests/lifecycle/*.test.ts",
    "test:backend:electron": "npm run backend:stage && npm run build && node scripts/virtual-display.ts playwright test --config playwright.lifecycle.config.ts",
    "test:backend:docker": "node backend-tests/smoke.ts",
    "test:electron": "npm run build && node scripts/virtual-display.ts playwright test"
  },
  "dependencies": {
    "@fontsource-variable/sixtyfour": "5.3.0",
    "@fontsource/share-tech-mono": "5.3.0",
    "@fontsource/source-code-pro": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "20.1.4",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "4.2.2",
    "@types/node": "20.19.39",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.4",
    "jiti": "2.7.0",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.0",
    "vite": "8.3.4"
  },
  "homepage": "https://github.com/Tachion-Oy/robozium",
  "author": "Tachion Oy",
  "build": {
    "appId": "fi.tachion.robozium",
    "productName": "Robozium",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": ".stage/backend",
        "to": "backend/stage"
      },
      {
        "from": "compose.yaml",
        "to": "backend/compose.yaml"
      },
      {
        "from": "src/backend-layout.json",
        "to": "backend/src/backend-layout.json"
      }
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Development",
      "icon": "dist/icon.svg",
      "executableName": "robozium",
      "maintainer": "Tachion Oy <https://github.com/Tachion-Oy/robozium>",
      "synopsis": "Run and supervise Robozium agents from the desktop",
      "syncDesktopName": true
    }
  },
  "desktopName": "robozium.desktop"
}
