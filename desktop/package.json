{
  "name": "robozium-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Robozium Electron scaffold",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "src/bootstrap.cjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "postinstall": "install-electron",
    "build": "node scripts/build-desktop.mjs",
    "start": "electron . --prepare",
    "start:built": "electron .",
    "start:preview": "electron . --prepare --preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p renderer/tsconfig.json && tsc -p tsconfig.tests.json && tsc -p tsconfig.vite.json",
    "backend:stage": "node scripts/stage-backend.mjs",
    "test:backend": "node --test backend-tests/*.test.mjs",
    "test:backend:lifecycle": "tsc -p tsconfig.json && node --test backend-tests/lifecycle/*.test.mjs",
    "test:backend:electron": "npm run backend:stage && npm run build && playwright test --config playwright.lifecycle.config.ts",
    "test:backend:docker": "node backend-tests/smoke.mjs",
    "test:electron": "npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource/source-code-pro": "5.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.59.1",
    "@types/node": "20.19.39",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.0",
    "vite": "8.3.4"
  }
}
