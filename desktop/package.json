{
  "name": "robozium-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Robozium Electron scaffold",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "dist/main.js",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "postinstall": "install-electron",
    "build": "npm run typecheck && tsc -p tsconfig.node.json && vite build",
    "start": "npm run build && electron .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.renderer.json && tsc -p tsconfig.tests.json && tsc -p tsconfig.vite.json",
    "test:electron": "npm run build && playwright test"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.59.1",
    "@types/node": "20.19.39",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.0",
    "vite": "8.3.4"
  }
}
