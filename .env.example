# ./start uses these credentials; ./start --mock requires none.
# ROBOZIUM_WEB_PORT=6969
# Optional live hub location, relative to this repository or absolute.
# ROBOZIUM_HUB_ROOT=../Robozium-Hub
# See README's Optional encrypted credentials section to encrypt *_SECRET values.
# After creating .env.encrypt, delete .env. Nonsecret settings stay in
# .env.encrypt and the launcher reads them from there.

# Obtain credentials from the selected provider. Never commit .env.
OPENROUTER_API_KEY_SECRET=
CEREBRAS_API_KEY_SECRET=
GROQ_API_KEY_SECRET=

# Optional Proton email. Leave this section blank for normal app use.
# Install and sign in to Proton Mail Bridge on this host first. Use the IMAP
# password shown in Bridge, not your Proton login. The live dependency checker
# probes Bridge after credentials are available.
ROBOZIUM_PROTON_BRIDGE_USERNAME=
ROBOZIUM_PROTON_BRIDGE_PASSWORD_SECRET=
ROBOZIUM_PROTON_BRIDGE_IMAP_HOST=
ROBOZIUM_PROTON_BRIDGE_IMAP_PORT=
# Match Bridge's IMAP encryption setting: starttls or ssl.
ROBOZIUM_PROTON_BRIDGE_TLS_MODE=
# Email address used in the From field.
ROBOZIUM_PROTON_BRIDGE_ACCOUNT_ADDRESS=
# SHA-256 fingerprint of Bridge's IMAP TLS certificate.
ROBOZIUM_PROTON_BRIDGE_CERTIFICATE_SHA256=
