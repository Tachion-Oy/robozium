# ./start uses these credentials; ./start --mock requires none.
# ROBOZIUM_WEB_PORT=6969
# Optional live hub location, relative to this repository or absolute.
# ROBOZIUM_HUB_ROOT=../Robozium-Hub
# Encrypt all *_SECRET values with:
#   uv run python -m robozium.secret_env encrypt
# After creating .env.encrypt, delete .env. Nonsecret settings stay in
# .env.encrypt and the launcher reads them from there.

# Obtain credentials from the selected provider. Never commit .env.
OPENROUTER_API_KEY_SECRET=
CEREBRAS_API_KEY_SECRET=
GROQ_API_KEY_SECRET=

# Proton Bridge settings. The _SECRET suffix marks a value for encryption;
# the API receives it as PEFFAHUB_PROTON_BRIDGE_PASSWORD after unlock.
PEFFAHUB_PROTON_BRIDGE_USERNAME=
PEFFAHUB_PROTON_BRIDGE_PASSWORD_SECRET=
PEFFAHUB_PROTON_BRIDGE_IMAP_HOST=
PEFFAHUB_PROTON_BRIDGE_IMAP_PORT=
PEFFAHUB_PROTON_BRIDGE_TLS_MODE=
PEFFAHUB_PROTON_BRIDGE_ACCOUNT_ADDRESS=
PEFFAHUB_PROTON_BRIDGE_CERTIFICATE_SHA256=
