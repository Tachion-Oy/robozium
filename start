#!/bin/sh
set -eu
cd "$(dirname "$0")"

case "${1:-}" in
  --mock) export ROBOZIUM_MODE=mock ;;
  "") export ROBOZIUM_MODE=live ;;
  *) echo "Usage: ./start [--mock]" >&2; exit 2 ;;
esac

if [ -f .env.encrypt ]; then
  docker compose -f compose.yaml -f compose.encrypted.yaml up --build
else
  docker compose up --build
fi
