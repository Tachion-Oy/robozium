{
  "hub": {
    "name": "RoboSprawl"
  },
  "sandbox": {
    "root": ".runtime/data",
    "readonly": "readonly",
    "workspace": "workspace",
    "projects": "projects",
    "safe_scripts": "safe-scripts"
  },
  "project": {
    "logs": "conversation_logs",
    "snapshots": "conversation_snapshots",
    "memory": "persistent_memory"
  },
  "logging": {
    "console": {
      "level": "INFO"
    },
    "file": {
      "path": ".runtime/logs/backend.jsonl",
      "level": "DEBUG",
      "max_bytes": 26214400,
      "backup_count": 5,
      "on_error": "fail"
    }
  },
  "deployment": {
    "endpoints": {
      "glm": {
        "label": "GLM-5.3 · OpenRouter",
        "api_name": "openrouter",
        "model": "z-ai/glm-5.3",
        "base_url": "https://openrouter.ai/api/v1",
        "api_key_env": "OPENROUTER_API_KEY",
        "max_context_tokens": 1310720,
        "extra_body": {
          "provider": {
            "sort": "throughput",
            "require_parameters": true
          },
          "reasoning": {
            "effort": "low"
          }
        }
      },
      "glm-flash": {
        "label": "GLM-5.3 Flash · OpenRouter",
        "api_name": "openrouter",
        "model": "z-ai/glm-5.3-flash",
        "base_url": "https://openrouter.ai/api/v1",
        "api_key_env": "OPENROUTER_API_KEY",
        "max_context_tokens": 1310720,
        "extra_body": {
          "provider": {
            "sort": "throughput",
            "require_parameters": true
          },
          "reasoning": {
            "effort": "low"
          }
        }
      },
      "gpt-oss": {
        "label": "GPT-OSS-120B · Cerebras",
        "api_name": "cerebras",
        "model": "gpt-oss-120b",
        "base_url": "https://api.cerebras.ai/v1",
        "api_key_env": "CEREBRAS_API_KEY",
        "max_context_tokens": 131072
      },
      "memory": {
        "label": "Librarian",
        "api_name": "openrouter",
        "model": "z-ai/glm-5.3",
        "base_url": "https://openrouter.ai/api/v1",
        "api_key_env": "OPENROUTER_API_KEY",
        "max_context_tokens": 1310720,
        "extra_body": {
          "provider": {
            "sort": "throughput",
            "require_parameters": true
          },
          "reasoning": {
            "effort": "high"
          }
        }
      }
    },
    "selectable_models": [
      "glm",
      "glm-flash",
      "gpt-oss"
    ],
    "default_model": "glm",
    "memory_model": "memory"
  }
}
